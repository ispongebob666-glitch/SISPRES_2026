# ===== Salin file ini menjadi .env (lokal) dan isi nilainya =====
# JANGAN commit file .env ke GitHub.

# --- Supabase (dipakai SERVER saja) ---
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci "service_role" / "secret". RAHASIA: jangan pakai awalan VITE_, jangan commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login admin (disarankan diisi; jika kosong memakai bawaan lama admin/admin123) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# --- Opsional: rahasia penanda token admin (jika kosong memakai SUPABASE_SERVICE_ROLE_KEY) ---
ADMIN_TOKEN_SECRET=
